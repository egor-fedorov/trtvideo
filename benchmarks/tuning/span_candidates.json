{
  "schema_version": 2,
  "selection": {
    "metric": "median_end_to_end_fps",
    "equivalence_margin": 0.01,
    "max_relative_spread": 0.05,
    "tie_breaker": "lowest_num_streams_then_graph_off"
  },
  "search": {
    "minimum_streams": 1,
    "maximum_streams": 8,
    "decline_margin": 0.01,
    "decline_patience": 2,
    "sentinel_streams": 8,
    "shortlist_size": 3,
    "reconnaissance": {
      "measured_frames": 1000,
      "warmup_frames": 100,
      "initial_runs": 1,
      "extra_runs_on_spread": 0,
      "spread_threshold": 0.01,
      "max_relative_spread": 0.05,
      "idle_seconds": 0,
      "bitrate_validation": true
    },
    "confirmation": {
      "measured_frames": 1000,
      "warmup_frames": 100,
      "initial_runs": 3,
      "extra_runs_on_spread": 2,
      "spread_threshold": 0.01,
      "max_relative_spread": 0.05,
      "idle_seconds": 10,
      "bitrate_validation": true
    }
  },
  "project_profile": {
    "backend": "nvcodec",
    "cuda_graph": false
  },
  "implementations": {
    "vstrt": {
      "requests": "auto",
      "vapoursynth_threads": "auto",
      "probe_cuda_graph": true
    },
    "vsgan": {
      "requests": "auto",
      "vapoursynth_threads": "auto",
      "probe_cuda_graph": true
    }
  }
}
