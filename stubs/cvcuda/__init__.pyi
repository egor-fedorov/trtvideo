from enum import Enum
from types import TracebackType

from trtvideo.runtime.buffers import CudaArray, DLPackProvider

class Type(Enum):
    U8 = ...
    F16 = ...
    F32 = ...

class ColorSpec(Enum):
    BT601 = ...
    BT709 = ...
    BT2020 = ...

class ColorConversion(Enum):
    YUV2RGB_NV12 = ...
    RGB2YUV_NV12 = ...

class Stream:
    def __init__(self) -> None: ...
    @property
    def handle(self) -> int: ...
    def sync(self) -> None: ...
    def __enter__(self) -> Stream: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

class Tensor:
    def __init__(
        self, shape: tuple[int, ...], dtype: Type, layout: str | None = None, rowalign: int = 0
    ) -> None: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dtype(self) -> Type: ...
    def cuda(self) -> CudaArray: ...
    def reshape(self, shape: tuple[int, ...], layout: str | None = None) -> Tensor: ...

def as_tensor(buffer: CudaArray | DLPackProvider, layout: str | None = None) -> Tensor: ...
def convertto_into(
    dst: Tensor, src: Tensor, scale: float = 1, offset: float = 0, *, stream: Stream | None = None
) -> Tensor: ...
def reformat_into(dst: Tensor, src: Tensor, *, stream: Stream | None = None) -> Tensor: ...
def advcvtcolor_into(
    dst: Tensor,
    src: Tensor,
    code: ColorConversion,
    spec: ColorSpec,
    *,
    stream: Stream | None = None,
) -> Tensor: ...
