from enum import IntEnum

class cudaError_t(IntEnum):
    cudaSuccess = 0

class cudaMemcpyKind(IntEnum):
    cudaMemcpyDeviceToHost = 2

class cudaEvent_t:
    def __int__(self) -> int: ...

class cudaStream_t:
    def __int__(self) -> int: ...

class cudaDeviceProp:
    name: bytes

def cudaSetDevice(device: int) -> tuple[cudaError_t]: ...
def cudaGetDeviceProperties(device: int) -> tuple[cudaError_t, cudaDeviceProp]: ...
def cudaEventCreate() -> tuple[cudaError_t, cudaEvent_t]: ...
def cudaEventRecord(event: cudaEvent_t | int, stream: cudaStream_t | int) -> tuple[cudaError_t]: ...
def cudaEventElapsedTime(
    start: cudaEvent_t | int, end: cudaEvent_t | int
) -> tuple[cudaError_t, float]: ...
def cudaEventDestroy(event: cudaEvent_t | int) -> tuple[cudaError_t]: ...
def cudaMemcpy2D(
    dst: int, dpitch: int, src: int, spitch: int, width: int, height: int, kind: cudaMemcpyKind
) -> tuple[cudaError_t]: ...
